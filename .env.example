# Copy to .env and fill in. Never commit real keys.

# Model gateway (OpenAI-compatible, e.g. OpenRouter)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Cheap fast model for easy calls
SMALL_MODEL=
# Best model for hard calls
STRONG_MODEL=

# Text-to-speech provider key
TTS_API_KEY=

# Where jobs, screenshots, audio, videos and the SQLite file are stored
DATA_DIR=./data

# Optional public URL used when generating links.
PUBLIC_BASE_URL=

# Set to 1 to start the app before configuring required keys.
# SKIP_STARTUP_CHECK=1
